# Repo del EDITOR DE PERSONAJES Y ESCENAS: lista blanca. Todo lo demás de shorts-flow (vídeos, voces, renders) queda fuera.
/*
!/.gitignore
!/README.md
!/sincronizar.ps1
!/ROADMAP.md

!/editor-personajes/
!/personajes/
!/acciones/
!/andares/
!/piezas/
!/escenas/
!/shorts/
# app de escritorio (Electron): el código, sin dependencias ni instaladores
!/app-escritorio/
/app-escritorio/node_modules/
/app-escritorio/dist/

# del motor común, solo lo que usa el editor
!/comun/
/comun/*
!/comun/titere25d.js
!/comun/personajes.js
!/comun/escena.js
!/comun/montaje.js
!/comun/atrezo.js
!/comun/andares.js
!/comun/rig2d.js
!/comun/libre.js
!/comun/vendor/

# generados o temporales
/personajes/todos.js
/acciones/todas.js
/andares/todas.js
/andares/papelera/
*/papelera/
*.bak
!/ilustraciones/
!/comun/lamina-vectorizar.py
/app-escritorio/recursos/
